# ── MCP backend runtime configuration ──────────────────────────────────────
# Copy to `.env` for local development. In-cluster these are set via the
# Deployment env / ConfigMap (never commit real values).

# HTTP server
PORT=8080
# Path the Streamable HTTP MCP endpoint is served on.
MCP_HTTP_PATH=/mcp
# Comma-separated Host allow-list (bare hostnames, NO ports) for DNS-rebinding
# protection. Leave empty to disable (fine behind a trusted ingress/ALB). For
# local dev you might set: 127.0.0.1,localhost,[::1]
MCP_ALLOWED_HOSTS=

# ── OpenTelemetry ──────────────────────────────────────────────────────────
# Logical service identity (shows up in Tempo/Prometheus/Loki).
OTEL_SERVICE_NAME=mcp-backend
# Base OTLP/HTTP endpoint of the gateway collector. The SDK appends
# /v1/traces and /v1/metrics automatically. In-cluster default points at the
# OpenTelemetry Operator gateway collector in the `observability` namespace.
OTEL_EXPORTER_OTLP_ENDPOINT=http://gateway-collector.observability.svc:4318
# http/protobuf (default) or http/json.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Deployment environment resource attribute.
OTEL_DEPLOYMENT_ENVIRONMENT=dev
# Set to "true" to print spans/metrics to the console instead of exporting
# (handy for local dev without a collector running).
OTEL_DEBUG=false
