# ── MCP backend runtime configuration ──────────────────────────────────────
# Copy to `.env` for local development. In-cluster these are set via the
# Deployment env / ConfigMap (never commit real values).

# HTTP server
PORT=8080
# Path the Streamable HTTP MCP endpoint is served on.
MCP_HTTP_PATH=/mcp
# Comma-separated Host allow-list (bare hostnames, NO ports) for DNS-rebinding
# protection. Leave empty to disable (fine behind a trusted ingress/ALB). For
# local dev you might set: 127.0.0.1,localhost,[::1]
MCP_ALLOWED_HOSTS=

# ── OpenTelemetry ──────────────────────────────────────────────────────────
# Logical service identity (shows up in Tempo/Prometheus/Loki).
OTEL_SERVICE_NAME=mcp-backend
# Base OTLP/HTTP endpoint of the gateway collector. The SDK appends
# /v1/traces and /v1/metrics automatically. In-cluster default points at the
# OpenTelemetry Operator gateway collector in the `observability` namespace.
OTEL_EXPORTER_OTLP_ENDPOINT=http://gateway-collector.observability.svc:4318
# http/protobuf (default) or http/json.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Deployment environment resource attribute.
OTEL_DEPLOYMENT_ENVIRONMENT=dev
# Set to "true" to print spans/metrics to the console instead of exporting
# (handy for local dev without a collector running).
OTEL_DEBUG=false

# ── PostgreSQL (Amazon RDS) ────────────────────────────────────────────
# In-cluster these come from the K8s Secret that External Secrets Operator
# materialises from the AWS Secrets Manager entry `eks-golden/rds-master`.
# NEVER commit a real password.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
# TLS verification against the Amazon RDS CA bundle. Set PGSSL=false ONLY for a
# throwaway local Postgres; against RDS, leaving it on with a CA path is what
# makes the connection actually authenticated rather than merely encrypted.
PGSSL=false
PGSSLROOTCERT=
# Postgres schema this environment owns. dev/stage/prod run against ONE RDS
# database, so each MUST set its own here or they share the api_keys table.
# Local development against a throwaway Postgres can leave this as public.
PGSCHEMA=public
# Keep the per-pod pool small: db.t4g.micro tops out near 85 connections and
# three environments share the one instance.
PG_POOL_MAX=5
